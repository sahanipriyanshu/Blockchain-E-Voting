# Copy this file to .env and fill in your values.
# Do not commit .env to git (it should be in .gitignore).

# Required: MongoDB connection string
# Local:    mongodb://localhost:27017/evoting
# Atlas:    mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/evoting?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/evoting

# Required: Secret key for JWT authentication (use a long random string)
JWT_SECRET=change_this_to_a_random_secret_key

# Optional: Server port (default 5002)
PORT=5002

# Optional: Vote encryption (app has defaults if omitted)
# ENCRYPTION_KEY=your_32_char_encryption_key_here
# SIGNATURE_KEY=your_signature_key_here
